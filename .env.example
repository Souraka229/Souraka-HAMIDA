# ============================================
# REQUIRED: Core Configuration
# ============================================

# Node Environment
NODE_ENV=development

# ============================================
# DATABASE: Supabase (PostgreSQL)
# Get from: https://supabase.com
# ============================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...

# ============================================
# AI APIs: Generation & Completion
# ============================================

# OpenAI - Code & Text Generation
# Get from: https://platform.openai.com/account/api-keys
# Cost: $5 free credit, then ~$0.50/1M tokens
# Models: gpt-4-mini, gpt-4, gpt-3.5-turbo
OPENAI_API_KEY=sk-proj-...

# Groq - Ultra-Fast Streaming (OPTIONAL)
# Get from: https://console.groq.com
# Cost: Completely free
# Models: mixtral-8x7b-32768, llama2-70b
GROQ_API_KEY=gsk_...

# ============================================
# CACHE & SESSION: Vercel KV (OPTIONAL)
# Get from: Vercel Dashboard → Storage → KV
# Cost: Free tier includes 10,000 commands/day
# ============================================

KV_URL=redis://default:...@...vercel.sh:...
KV_REST_API_URL=https://....vercel.sh
KV_REST_API_TOKEN=...

# ============================================
# JSON STORAGE: JSONBin (OPTIONAL)
# Get from: https://jsonbin.io
# Cost: 10 free bins, 100KB each
# ============================================

JSONBIN_BIN_ID=abc123def456
JSONBIN_API_KEY=$2b$10$...

# ============================================
# Optional: Additional Configuration
# ============================================

# Database URLs (if using direct connection)
POSTGRES_URL=postgresql://user:password@host:5432/database
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/database

# JWT
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Application
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# ============================================
# IMPORTANT NOTES:
# ============================================
# 1. Copy this file to .env.local for development
# 2. Add all REQUIRED variables before running `npm run dev`
# 3. Add optional variables only if you plan to use them
# 4. Never commit secrets to git
# 5. Add the same variables to Vercel Dashboard:
#    Settings → Environment Variables
# ============================================
